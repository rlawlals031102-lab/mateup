{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "www",
  "regions": [
    "icn1"
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/settle",
      "schedule": "0 15 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/demo",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/demo/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
