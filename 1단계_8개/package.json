{
  "name": "studybuddy",
  "version": "0.1.0",
  "private": true,
  "description": "스터디버디 - 1주일 단위 1:1 스터디 메이트 매칭 플랫폼 (MateUp)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js --demo",
    "demo": "node server/index.js --demo",
    "test": "node --test",
    "build:standalone": "node scripts/build-standalone.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "dev:db": "node --env-file=.env.local server/index.js",
    "test:e2e": "node e2e/flow.mjs",
    "backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "restore:check": "node scripts/restore-check.mjs",
    "ops": "node --env-file-if-exists=.env.local scripts/ops.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "esbuild": "^0.25.12",
    "jsqr": "1.4.0",
    "sql.js": "1.13"
  }
}
